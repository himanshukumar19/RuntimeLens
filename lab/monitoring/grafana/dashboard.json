    {
      "collapsed": false,
      "description": "Classification inference latency tracking across p50, p95, and p99 percentiles",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "showPoints": "auto",
            "spanNulls": false
