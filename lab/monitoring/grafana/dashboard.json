        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, model) (rate(runtimelens_classification_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 ({{model}})",
          "refId": "C"
        }
      ],
      "title": "Pipeline Latency p50 / p95 / p99",
      "type": "timeseries"
